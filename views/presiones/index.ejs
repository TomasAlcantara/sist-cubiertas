<%
const currentPage = 'presiones';
// Las medidas sin presión cargada no se esconden: que se vean vacías es lo que
// avisa al admin que falta cargarlas.
const conPresion = medidas.filter(m => m.presion != null);
const sinPresion = medidas.filter(m => m.presion == null);
const body = `
<style>
.psi-wrap { max-width: 620px; margin: 0 auto; }
.psi-tabla { width: 100%; border-collapse: collapse; margin-top: 1rem; }
.psi-tabla th {
  background: var(--red); color: #fff;
  font-family: var(--font-display); font-size: 1rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase;
  padding: 12px; text-align: center;
}
.psi-tabla td {
  border: 1px solid var(--border-strong);
  padding: 11px 12px; text-align: center;
  font-family: var(--font-mono); font-size: 1.05rem; font-weight: 600;
}
.psi-tabla tr:nth-child(even) td { background: var(--bg-surface); }
.psi-sin { color: var(--text-muted); font-weight: 400; font-style: italic; }
.psi-min {
  margin-top: 1.5rem; padding: 18px;
  background: var(--bg-surface); border: 1px solid var(--border-strong);
  border-left: 4px solid var(--red); border-radius: var(--radius);
  text-align: center;
}
.psi-min span {
  display: block; font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--text-muted); margin-bottom: 6px;
}
.psi-min strong {
  font-family: var(--font-display); font-size: 2.4rem; font-weight: 800;
  color: var(--red); line-height: 1;
}
.psi-nota {
  margin-top: 1.25rem; font-size: 12px; line-height: 1.55;
  color: var(--text-secondary);
}
</style>

<div class="psi-wrap">
  <div class="list-head"><h2>Presión de Neumáticos</h2></div>
  <p class="dash-sub" style="font-family:var(--font-mono);font-size:10.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);">
    Presión obligatoria de inflado según medida
  </p>

  <table class="psi-tabla">
    <thead><tr><th>Medida</th><th>Presión (PSI)</th></tr></thead>
    <tbody>
      ${medidas.length === 0
        ? '<tr><td colspan="2" class="psi-sin">Sin medidas cargadas</td></tr>'
        : conPresion.map(m => `<tr><td>${e(m.medida)}</td><td>${m.presion}</td></tr>`).join('')
          + sinPresion.map(m => `<tr><td>${e(m.medida)}</td><td class="psi-sin">sin cargar</td></tr>`).join('')
      }
    </tbody>
  </table>

  <div class="psi-min">
    <span>Profundidad mínima aceptable</span>
    <strong>${cfg.mm_min} mm</strong>
  </div>

  ${can('admin') ? `<p class="psi-nota">
    Las presiones se cargan en <a href="/admin/medidas">Administración &rsaquo; Medidas</a>
    y la profundidad mínima en <a href="/admin/config">Administración &rsaquo; Configuración</a>.
  </p>` : ''}
</div>
`;
%>
<%- include('../layout', { body, user, currentPage }) %>
