<%
const currentPage = 'admin';
const body = `
<div class="list-head">
  <h2>Medidas</h2>
  <a href="/admin/medidas/nuevo" class="btn-nuevo">Nueva Medida</a>
</div>
<table>
  <thead><th>Medida</th><th>Presión</th><th style="width:200px;">Editar</th></thead>
  ${medidas.map((m,i)=>`<tr class="${i%2===0?'light':'dark'}">
    <td>${e(m.medida)}</td>
    <td align="center" style="font-family:var(--font-mono)">${m.presion != null
      ? m.presion + ' psi'
      : '<span style="color:var(--text-muted); font-style:italic;">sin cargar</span>'}</td>
    <td align="center"><a href="/admin/medidas/editar?medida=${m.id}">EDITAR</a></td>
  </tr>`).join('')}
</table>
<p style="font-size:12px; color:var(--text-muted); margin-top:10px;">
  Las presiones cargadas acá alimentan la <a href="/presiones">tabla de consulta del taller</a>.
</p>
<a href="/admin" class="list-back">&laquo; Volver</a>
`;
%>
<%- include('../../layout', { body, user, currentPage }) %>
