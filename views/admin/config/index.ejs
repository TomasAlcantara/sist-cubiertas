<%
const currentPage = 'admin';
const claves = Object.keys(campos);
const body = `
<script>
function guardar_config() {
  var data = {};
  ${ej(claves)}.forEach(function(k) {
    data[k] = document.getElementById('cfg_' + k).value;
  });
  $.ajax({ type:'POST', url:'/ajax/save_config', data: data,
    success: function(msg) { alert(msg || 'Guardado'); location.reload(); },
    error: function(xhr) { alert(xhr.responseText || 'Error al guardar'); }
  });
}
</script>
<div class="form-card">
  <div class="form-header"><h2>Configuración</h2></div>

  <div class="cfg-seccion">Profundidad de dibujo</div>
  ${['mm_min','mm_max'].map(k => `
  <div class="field">
    <label for="cfg_${k}">${campos[k].label}</label>
    <input type="number" id="cfg_${k}" class="text" min="${campos[k].min}" max="${campos[k].max}" value="${cfg[k]}" />
  </div>`).join('')}
  <p class="field-hint" style="margin-bottom:1.25rem;">
    El mínimo es el umbral que pinta en rojo las mediciones al cargar una OT y el que
    figura en la <a href="/presiones">tabla de presiones</a>.
  </p>

  <div class="cfg-seccion">Intervalos de mantenimiento</div>
  ${['dias_alineacion','dias_preventivo'].map(k => `
  <div class="field">
    <label for="cfg_${k}">${campos[k].label}</label>
    <input type="number" id="cfg_${k}" class="text" min="${campos[k].min}" max="${campos[k].max}" value="${cfg[k]}" />
  </div>`).join('')}
  <p class="field-hint" style="margin-bottom:1.25rem;">
    Definen cuándo una unidad aparece vencida en <a href="/mantenimiento">Mantenimiento</a>.
  </p>

  <div class="form-actions">
    <button class="btn-primary" onclick="guardar_config()">Guardar</button>
    <button class="btn-ghost"   onclick="location.href='/admin'">Volver</button>
  </div>
</div>
<style>
.cfg-seccion {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--text-muted);
  margin: 0 0 10px 0; padding-bottom: 6px; border-bottom: 1px solid var(--border);
}
</style>
`;
%>
<%- include('../../layout', { body, user, currentPage }) %>
