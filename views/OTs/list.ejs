<%
const currentPage = 'inicio';
const trabajosTooltip = (o) => {
  const items = [
    ['Rotación', o.rotacion],
    ['Arreglo',  o.arreglo],
    ['Cambio',   o.cambio],
    ['Alinear',  o.alinear],
    ['Balanceo', o.balanceo],
    ['Armar',    o.armar],
    ['Preventivo', o.preventivo],
    ['Pinchadura', o.pinchadura],
    ['Rotura',     o.rotura],
  ];
  const filas = items.map(([n, v]) =>
    '<tr><td style="color:var(--text-secondary)">' + n + ':</td><td style="padding-left:6px; color:' + (v ? '#2e7d32' : 'var(--red-bright)') + '; font-weight:bold;">' + (v ? 'SI' : 'NO') + '</td></tr>'
  ).join('');
  return '<span class="trab-wrap">Ver Trabajos'
    + '<span class="trab-tip"><table style="border-collapse:collapse; font-size:12px;">' + filas + '</table></span>'
    + '</span>';
};
// Solo preventivo = preventivo tildado y ningun otro trabajo. Es la unica OT
// que puede cerrar un gomero; el resto las cierra un administrador.
const soloPreventivo = (o) => !!o.preventivo &&
  !o.rotacion && !o.arreglo && !o.cambio && !o.alinear && !o.balanceo && !o.armar;

const accionesAbierta = (o) => {
  const acciones = [];
  if (can('ot_editar')) {
    acciones.push('<a href="/OTs/editar?ot=' + o.id + '">EDITAR</a>');
    acciones.push('<a href="/OTs/cargar?ot=' + o.id + '">CARGAR</a>');
  }
  if (can('ot_cerrar') || (can('ot_cerrar_preventivo') && soloPreventivo(o))) {
    acciones.push('<a style="cursor:pointer;" onclick="open_carga(' + o.id + ')">CERRAR</a>');
  } else if (can('ot_cerrar_preventivo')) {
    acciones.push('<span style="color:var(--text-muted); font-size:11px;" title="Tiene trabajos realizados: la cierra un administrador">Cierra admin</span>');
  }
  if (!acciones.length) acciones.push('<a href="/OTs/ver?ot=' + o.id + '">VER</a>');
  return acciones.join(' | ');
};

// Ingreso = alta de la OT, salida = cierre. La demora entre las dos es lo que
// tardo el trabajo. Las OTs viejas no tienen hora real guardada (creado_en
// backfilleado a medianoche, cierres previos a la auditoria): ahi no se inventa
// una duracion, se muestra "sin dato".
const tiemposCelda = (o) => {
  const abierta = o.estado == 0 && !o.anulada;
  const salida = o.cerrado_en
    ? fmtFechaHora(o.cerrado_en)
    : (abierta ? '<span class="ot-t-vacio">en curso</span>' : '<span class="ot-t-vacio">sin dato</span>');
  const demora = abierta
    ? fmtDuracion(o.creado_en, new Date())
    : fmtDuracion(o.creado_en, o.cerrado_en);
  return '<div><span class="ot-t-lbl">Ing</span>' + fmtFechaHora(o.creado_en) + '</div>'
    + '<div><span class="ot-t-lbl">Sal</span>' + salida + '</div>'
    + (demora
        ? '<div class="ot-demora' + (abierta ? ' abierta' : '') + '" title="'
          + (abierta ? 'Tiempo transcurrido con la OT abierta' : 'Tiempo entre el ingreso y el cierre') + '">'
          + demora + '</div>'
        : '');
};

const hayFiltros = !!(filtros.numero || filtros.desde || filtros.hasta || filtros.anuladas)
  || filtros.unidad > 0 || filtros.gomeria > 0 || filtros.estado !== -1;
const body = `
<style>
.trab-wrap { cursor:default; color:var(--red); font-weight:bold; white-space:nowrap; }
.trab-tip { display:none; position:fixed; background:var(--bg-card); border:1px solid var(--border-strong); padding:6px 10px; z-index:9999; box-shadow:var(--shadow-sm); white-space:nowrap; border-radius:var(--radius); pointer-events:none; }

.ot-tiempos { font-family:var(--font-mono); font-size:11px; white-space:nowrap; line-height:1.55; text-align:left; }
.ot-t-lbl { display:inline-block; width:30px; color:var(--text-muted); }
.ot-t-vacio { color:var(--text-muted); font-style:italic; }
.ot-demora { margin-top:2px; padding-left:30px; font-weight:bold; color:var(--red); }
.ot-demora.abierta { color:var(--text-muted); font-weight:normal; }

.ot-filters {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}
.ot-filters strong {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  white-space: nowrap;
}
.ot-filters select { width: auto; }
.ot-filters-submit {
  background: var(--bg-surface);
  color: var(--text-primary);
  border: 1px solid var(--border-strong);
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  padding: 8px 18px;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.12s;
}
.ot-filters-submit:hover { background: var(--bg-hover); }
.ot-nueva {
  margin-left: auto;
  background: var(--red);
  color: #fff;
  border: none;
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  padding: 8px 20px;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.12s;
  white-space: nowrap;
}
.ot-nueva:hover { background: var(--red-bright); }
.ot-filters-clear {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--text-muted); text-decoration: none;
  padding: 8px 4px;
}
.ot-filters-clear:hover { color: var(--red); }

.ot-modal {
  width: min(960px, 96vw);
  max-height: 92vh;
  overflow-y: auto;
  position: fixed;
  background: var(--bg-card);
  z-index: 99;
  display: none;
  top: 40px;
  left: 50%;
  transform: translateX(-50%);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}
.ot-overlay {
  display: none;
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
  z-index: 98;
}
</style>
<script>
// Tooltip de trabajos — position:fixed para evitar clipping en tabla
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.trab-wrap').forEach(function(wrap) {
    var tip = wrap.querySelector('.trab-tip');
    wrap.addEventListener('mouseenter', function() {
      var r = wrap.getBoundingClientRect();
      tip.style.display = 'block';
      var left = r.right + 10;
      var top  = r.top + r.height / 2 - tip.offsetHeight / 2;
      // si se sale por la derecha, mostrar a la izquierda
      if (left + tip.offsetWidth > window.innerWidth - 10) left = r.left - tip.offsetWidth - 10;
      // si se sale por arriba o abajo, ajustar
      top = Math.max(8, Math.min(top, window.innerHeight - tip.offsetHeight - 8));
      tip.style.left = left + 'px';
      tip.style.top  = top  + 'px';
    });
    wrap.addEventListener('mouseleave', function() {
      tip.style.display = 'none';
    });
  });
});

$(function() {
  $('#f_desde, #f_hasta').datepicker({ dateFormat: 'dd/mm/yy' });
});

function open_carga(id) {
  $.ajax({ type:'POST', url:'/ajax/mb_cerrar_ot', data:{ ot_id: id },
    success: function(data) {
      if (data) {
        document.getElementById('cerrar_ot').innerHTML = data;
        document.getElementById('back').style.display = 'block';
        document.getElementById('cerrar_ot').style.display = 'block';
      }
    },
    error: function() {
      alert('Error al cargar el formulario de cierre');
    }
  });
}
function close_carga() {
  document.getElementById('back').style.display = 'none';
  document.getElementById('cerrar_ot').style.display = 'none';
}
// El formulario de cierre viene recortado para el gomero (sin trabajos, factura
// ni destino), así que todo se lee con guardas en vez de asumir que existe.
function _val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
function _chk(id) { var el = document.getElementById(id); return el && el.checked ? '1' : '0'; }

function confirmar_cerrar(ot_id) {
  var km = _val('km_cierre');
  if (!km) { alert('Ingrese los km actuales'); return; }

  var descEl = document.getElementById('descripcion_cierre');
  var esPreventivo = !document.getElementById('cb_rot_cierre'); // formulario reducido
  if (esPreventivo && descEl && !descEl.value.trim()) {
    alert('Escribí qué se revisó en el preventivo');
    descEl.focus();
    return;
  }

  var destinoEl = document.getElementById('destino_almacen_id');
  var destinoNombre = destinoEl ? destinoEl.options[destinoEl.selectedIndex].text : '';
  var destinoVal    = destinoEl ? destinoEl.value : '';
  $.ajax({ type:'POST', url:'/ajax/confirmar_cerrar_ot',
    data: {
      ot_id: ot_id,
      km_actual: km,
      factura: _val('factura_cierre'),
      costo:   _val('costo_cierre'),
      rotacion: _chk('cb_rot_cierre'),
      arreglo:  _chk('cb_arr_cierre'),
      cambio:   _chk('cb_cam_cierre'),
      alinear:  _chk('cb_ali_cierre'),
      balanceo: _chk('cb_bal_cierre'),
      armar:    _chk('cb_arm_cierre'),
      preventivo: _chk('cb_pre_cierre'),
      descripcion_cierre: descEl ? descEl.value : '',
      destino_almacen_id: destinoVal
    },
    error: function(xhr) {
      alert(xhr.responseText || ('Error al cerrar la OT (' + xhr.status + ')'));
    },
    success: function(data) {
      if (data === 'ok') {
        close_carga();
        // Notificación de destino
        var notif = document.createElement('div');
        notif.style.cssText = [
          'position:fixed','top:24px','left:50%','transform:translateX(-50%)',
          'background:#1b5e20','color:#fff','padding:16px 28px',
          'border-radius:10px','font-size:14px','font-weight:600',
          'z-index:9999','box-shadow:0 6px 24px rgba(0,0,0,0.4)',
          'text-align:center','line-height:1.5','max-width:420px'
        ].join(';');
        notif.innerHTML = '✔ OT N°' + ot_id + ' cerrada correctamente' +
          (destinoNombre
            ? '<br><span style="font-weight:400;font-size:13px;">Cubiertas salientes enviadas a: <strong>' + destinoNombre + '</strong></span>'
            : '');
        document.body.appendChild(notif);
        setTimeout(function() {
          notif.style.transition = 'opacity 0.4s';
          notif.style.opacity = '0';
          setTimeout(function() { location.reload(); }, 450);
        }, 2800);
      } else {
        alert('Error al cerrar la OT');
      }
    }
  });
}
</script>

<div class="ot-overlay" id="back" onclick="close_carga();"></div>
<div class="ot-modal" id="cerrar_ot"></div>

<form method="get" action="/OTs/list" class="ot-filters">
  <strong>OT N°:</strong>
  <input type="text" name="numero" value="${e(filtros.numero || '')}" style="width:90px;" placeholder="N°" />
  <strong>Desde:</strong>
  <input type="text" name="desde" id="f_desde" value="${e(filtros.desde || '')}" style="width:105px;" placeholder="DD/MM/AAAA" autocomplete="off" />
  <strong>Hasta:</strong>
  <input type="text" name="hasta" id="f_hasta" value="${e(filtros.hasta || '')}" style="width:105px;" placeholder="DD/MM/AAAA" autocomplete="off" />
  <strong>Unidad:</strong>
  <select name="unidad">
    <option value="0">Todas</option>
    ${unidades.map(u => `<option value="${u.id}" ${u.id==filtros.unidad?'selected':''}>${u.unidad}</option>`).join('')}
  </select>
  <strong>Gomería:</strong>
  <select name="gomeria">
    <option value="0">Todas</option>
    ${gomerias.map(g => `<option value="${g.id}" ${g.id==filtros.gomeria?'selected':''}>${g.nombre}</option>`).join('')}
  </select>
  <strong>Estado:</strong>
  <select name="estado">
    <option value="-1" ${filtros.estado==-1?'selected':''}>Todos</option>
    <option value="0" ${filtros.estado==0?'selected':''}>Pendiente</option>
    <option value="1" ${filtros.estado==1?'selected':''}>Cerrada</option>
  </select>
  <label style="display:inline-flex; align-items:center; gap:5px; font-size:12px; white-space:nowrap;">
    <input type="checkbox" name="anuladas" value="1" ${filtros.anuladas ? 'checked' : ''} /> Ver anuladas
  </label>
  <button type="submit" class="ot-filters-submit">Filtrar</button>
  ${hayFiltros ? '<a href="/OTs/list" class="ot-filters-clear">Limpiar</a>' : ''}
  ${can('ot_crear') ? '<button type="button" class="ot-nueva" onclick="location.href=\'/OTs/nueva\'">Nueva OT</button>' : ''}
</form>

<table>
  <thead>
    <th>OT N°</th>
    <th>Micro</th>
    <th>Gomería</th>
    <th>Fecha</th>
    <th>Ingreso / Salida</th>
    <th>Km</th>
    <th>Solicitó</th>
    <th>Trabajos</th>
    <th>Estado</th>
    <th style="width:160px;">Editar</th>
  </thead>
  ${ots.length === 0 ? '<tr><td colspan="10" align="center">Sin órdenes de trabajo</td></tr>' :
    ots.map((o, i) => `<tr class="${i%2===0?'light':'dark'}">
      <td align="center">${o.numero || o.id}</td>
      <td align="center">${o.unidad||'-'}</td>
      <td align="center">${o.gomeria_nombre||'-'}</td>
      <td align="center">${fmtFecha(o.fecha)}</td>
      <td class="ot-tiempos">${tiemposCelda(o)}</td>
      <td align="center" style="font-family:var(--font-mono)">${o.km != null ? Number(o.km).toLocaleString('es-AR') : '-'}</td>
      <td align="center">${o.solicitado_por||'-'}</td>
      <td>${trabajosTooltip(o)}</td>
      <td align="center">${o.anulada
        ? '<strong style="color:var(--red-bright);" title="Anulada por ' + e(o.anulada_por||'-') + (o.motivo_anulacion ? ' — ' + e(o.motivo_anulacion) : '') + '">ANULADA</strong>'
        : '<strong>' + (o.estado==0?'Pendiente':'Cerrada') + '</strong>'}</td>
      <td align="center">
        ${o.anulada ? '<a href="/OTs/ver?ot='+o.id+'">VER</a>'
    : (o.estado==0 ? accionesAbierta(o) : '<a href="/OTs/ver?ot='+o.id+'">VER</a>')}
      </td>
    </tr>`).join('')
  }
</table>
`;
%>
<%- include('../layout', { body, user, currentPage }) %>
