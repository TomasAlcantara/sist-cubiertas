<%
const posNombre = (p) => ({
  ddi:'Del. Izq.', ddd:'Del. Der.',
  tie:'Tras. Izq. Ext.', tii:'Tras. Izq. Int.',
  tdi:'Tras. Der. Int.', tde:'Tras. Der. Ext.',
  cie:'Cen. Izq. Ext.', cii:'Cen. Izq. Int.',
  cdi:'Cen. Der. Int.', cde:'Cen. Der. Ext.',
  ra:'Auxilio', ra2:'Auxilio 2'
})[p] || p;

const currentPage = 'inicio';

// Ingreso = alta de la OT, salida = cierre. La demora sale de las dos: si
// alguna no tiene hora real guardada (OT vieja) no se muestra.
const abierta = ot.estado == 0 && !ot.anulada;
const salida = ot.cerrado_en ? fmtFechaHora(ot.cerrado_en) : (abierta ? 'En curso' : 'Sin dato');
const demora = abierta ? fmtDuracion(ot.creado_en, new Date()) : fmtDuracion(ot.creado_en, ot.cerrado_en);

const trabajos = [];
if (ot.rotacion) trabajos.push('Rotación');
if (ot.arreglo)  trabajos.push('Arreglo');
if (ot.cambio)   trabajos.push('Cambio');
if (ot.alinear)  trabajos.push('Alinear');
if (ot.balanceo) trabajos.push('Balanceo');
if (ot.armar)    trabajos.push('Armar');
if (ot.preventivo) trabajos.push('Preventivo');

// Cubiertas de la OT (las que se cambiaron/trabajaron)
const cubMap = {};
cubiertas.forEach(c => { if (c.posicion) cubMap[c.posicion] = c; });

// Cubiertas actuales de la unidad (todas las posiciones montadas). Solo llegan
// mientras la OT está abierta: una OT cerrada se dibuja con su `esquema`.
const unitMap = {};
(unitTires || []).forEach(t => { if (t.posicion) unitMap[t.posicion] = t; });

// La cubierta que cada entrante encontró en su posición. En una OT cerrada sale
// del esquema guardado; en una abierta, de la que quedó anotada al cargarla.
const saleDe = (c) => {
  const antes = esquema && esquema.antes[c.posicion];
  if (antes && antes.id !== c.id) return antes.fuego;
  return esquema ? null : c.fuego_anterior;
};

// Posiciones que esta OT dejó sin cubierta: no tienen fila propia, las suma la
// tabla. `destino` dice si esa cubierta pasó a otra posición o salió de la unidad.
const vaciadas = !esquema || !esquema.completo ? [] : Object.keys(esquema.antes)
  .filter(pos => !esquema.despues[pos])
  .map(pos => {
    const cubierta = esquema.antes[pos];
    return { posicion: pos, fuego: cubierta.fuego, destino: Object.keys(esquema.despues).find(p => esquema.despues[p].id === cubierta.id) };
  });

const tipoUnidad = ot.tipo_unidad || 3;

const motivos = [];
if (ot.pinchadura) motivos.push('PINCHADURA');
if (ot.rotura)     motivos.push('ROTURA');

const body = `
<style>
  .ver-wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .ver-wrap { grid-template-columns: 1fr; }
  }

  /* ── Info panel ── */
  .ver-info { min-width: 0; }
  .ver-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .ver-meta-item { font-size: 13px; color: var(--text-secondary); }
  .ver-meta-item strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2px;
    font-weight: 500;
  }

  /* ── Bus diagram ── */
  .diagrama-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1rem;
    min-width: 280px;
  }
  .diagrama-title {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
    align-self: flex-start;
  }
  .bus-row { display: flex; align-items: center; justify-content: center; }
  .bus-top-bot { background: var(--bg-card); border: 2px solid var(--border-strong); width: 200px; height: 14px; }
  .bus-side    { background: var(--bg-card); border-left: 2px solid var(--border-strong); border-right: 2px solid var(--border-strong); width: 200px; }
  .bus-axle    { background: var(--border); border-left: 2px solid var(--border-strong); border-right: 2px solid var(--border-strong); width: 200px; height: 20px; }
  .bus-spacer  { width: 62px; }
  .aux-row { margin-top: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .aux-label { font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); white-space: nowrap; }

  .rueda-ver {
    width: 62px;
    height: 80px;
    border: 2px solid var(--border-strong);
    border-radius: 4px;
    background: var(--bg-card);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 2px;
    gap: 3px;
    position: relative;
    cursor: default;
  }
  .rueda-ver.ocupada        { border-color: #888; background: rgba(0,0,0,0.04); }
  .rueda-ver.vacia          { border-style: dashed; opacity: 0.45; }
  .rueda-ver.vacia.ot-cambiada { opacity: 1; }
  .rueda-ver.sin-registro   { border-style: dotted; opacity: 0.35; }
  .rueda-sale {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--red-bright, #c62828);
    line-height: 1.1;
    text-align: center;
    word-break: break-all;
    padding: 0 2px;
  }
  .diagrama-nota {
    font-size: 11.5px;
    color: var(--text-muted);
    margin: 10px 0 0;
    max-width: 300px;
    text-align: center;
    line-height: 1.4;
  }

  .rueda-fuego {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: slashed-zero;
    color: var(--text-primary);
    text-align: center;
    line-height: 1.2;
    word-break: break-all;
    padding: 0 3px;
  }
  .rueda-fuego.empty { color: var(--text-muted); font-size: 18px; font-weight: 300; }
  .rueda-ver.ot-cambiada { outline: 2px solid var(--red); outline-offset: -2px; }
  .rueda-pos {
    font-family: var(--font-mono);
    font-size: 7.5px;
    color: var(--text-muted);
    text-align: center;
    line-height: 1.1;
    padding: 0 2px;
  }

  /* ── Legend ── */
  .leyenda {
    display: flex;
    gap: 12px;
    margin-top: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .leyenda-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
  }
  .leyenda-dot {
    width: 10px; height: 10px;
    border-radius: 2px;
    border: 2px solid;
    flex-shrink: 0;
  }
  .leyenda-dot.ocupada { border-color: #888; background: rgba(0,0,0,0.06); }
  .leyenda-dot.vacia   { border-color: var(--border-strong); border-style: dashed; background: transparent; }
  .leyenda-dot.cambiada { border-color: var(--red); background: transparent; }
  .leyenda-dot.sin-registro { border-color: var(--border-strong); border-style: dotted; background: transparent; opacity: 0.6; }

  /* ── Detail table ── */
  .ver-section-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 1.5rem 0 0.75rem;
  }
</style>

<script>
var LAYOUTS = {
  1: { del:['ddi','ddd'], tr1:['tie','tde'],             tr2:[],                      aux:['ra'],        bodyH:120 },
  2: { del:['ddi','ddd'], tr1:['cie','cii','cdi','cde'], tr2:['tie','tde'],            aux:['ra','ra2'],  bodyH:70  },
  3: { del:['ddi','ddd'], tr1:['tie','tii','tdi','tde'], tr2:[],                      aux:['ra','ra2'],  bodyH:120 },
  4: { del:['ddi','ddd'], tr1:['tie','tii','tdi','tde'], tr2:[],                      aux:['ra','ra2'],  bodyH:120 }
};

var CUBIERTA_MAP = ${JSON.stringify(cubMap)};
var UNIT_MAP     = ${JSON.stringify(unitMap)};
// Lo que la OT guardó de la unidad al cerrarse. null mientras está abierta.
var ESQUEMA      = ${JSON.stringify(esquema)};

var POS_LABELS = {
  ddi:'Del.\\nIzq.', ddd:'Del.\\nDer.',
  tie:'T.Iz.E', tii:'T.Iz.I', tdi:'T.De.I', tde:'T.De.E',
  cie:'C.Iz.E', cii:'C.Iz.I', cdi:'C.De.I', cde:'C.De.E',
  ra:'Aux.1', ra2:'Aux.2'
};

function esc(v) {
  return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// OT cerrada: se dibuja con lo que la OT guardó, nunca con la unidad de hoy.
// Sin el esquema completo (OTs anteriores a que se guardara) solo se conocen las
// posiciones que la OT cambió; del resto no hay registro y no se rellena.
function mkRuedaCerrada(pos) {
  var antes = ESQUEMA.antes[pos] || null;
  var despues = ESQUEMA.despues[pos] || null;
  var posLabel = '<span class="rueda-pos">' + (POS_LABELS[pos] || pos).replace('\\n', '<br>') + '</span>';
  if (!ESQUEMA.completo && !despues) {
    return '<div class="rueda-ver sin-registro" title="Sin registro de qué había en esta posición">' +
      '<span class="rueda-fuego empty">?</span>' + posLabel + '</div>';
  }
  var cambio = !ESQUEMA.completo ||
    (antes ? antes.id : null) !== (despues ? despues.id : null) ||
    (antes ? antes.fuego : null) !== (despues ? despues.fuego : null);
  var salio = cambio && antes ? (antes.fuego || '-') : null;
  var cls = 'rueda-ver ' + (despues ? 'ocupada' : 'vacia') + (cambio ? ' ot-cambiada' : '');
  var fuego = despues
    ? '<span class="rueda-fuego">' + esc(despues.fuego || '-') + '</span>'
    : '<span class="rueda-fuego empty">·</span>';
  var sale = salio ? '<span class="rueda-sale">sale ' + esc(salio) + '</span>' : '';
  var title = (despues ? (despues.fuego || '-') : 'Quedó vacía') +
    (salio ? ' · salió ' + salio : '') + (cambio ? ' (cambió en esta OT)' : '');
  return '<div class="' + cls + '" title="' + esc(title) + '">' + fuego + sale + posLabel + '</div>';
}

function mkRuedaVer(pos) {
  if (ESQUEMA) return mkRuedaCerrada(pos);
  // OT abierta. Prioridad: cubierta de la OT > cubierta actual de la unidad > vacía
  var c   = CUBIERTA_MAP[pos] || UNIT_MAP[pos] || null;
  var isOT = !!CUBIERTA_MAP[pos];
  var cls = 'rueda-ver ' + (c ? 'ocupada' : 'vacia') + (isOT ? ' ot-cambiada' : '');
  var fuego = c
    ? '<span class="rueda-fuego">' + (c.fuego || '-') + '</span>'
    : '<span class="rueda-fuego empty">·</span>';
  var posLabel = '<span class="rueda-pos">' + (POS_LABELS[pos] || pos).replace('\\n', '<br>') + '</span>';
  var title = c
    ? (c.fuego||'-') + (isOT ? ' (OT)' : '') + (c.marca ? ' · ' + c.marca + ' ' + (c.modelo_nombre||'') : '')
    : 'Sin cubierta';
  return '<div class="' + cls + '" title="' + title + '">' + fuego + posLabel + '</div>';
}

function renderDiagrama(tipo) {
  var L = LAYOUTS[tipo] || LAYOUTS[3];
  var del = L.del, tr1 = L.tr1, tr2 = L.tr2;
  var midD = Math.ceil(del.length / 2);
  var midT = Math.ceil(tr1.length / 2);
  var h = '';

  // Delantera
  h += '<div class="bus-row">';
  del.slice(0, midD).forEach(function(p) { h += mkRuedaVer(p); });
  h += '<div class="bus-spacer"></div><div style="width:180px;"></div><div class="bus-spacer"></div>';
  del.slice(midD).forEach(function(p) { h += mkRuedaVer(p); });
  h += '</div>';

  h += '<div class="bus-row"><div class="bus-spacer"></div><div class="bus-top-bot"></div><div class="bus-spacer"></div></div>';
  h += '<div class="bus-row"><div class="bus-spacer"></div><div class="bus-side" style="height:' + L.bodyH + 'px;"></div><div class="bus-spacer"></div></div>';
  h += '<div class="bus-row"><div class="bus-spacer"></div><div class="bus-top-bot"></div><div class="bus-spacer"></div></div>';

  // Eje trasero
  h += '<div class="bus-row">';
  tr1.slice(0, midT).forEach(function(p) { h += mkRuedaVer(p); });
  h += '<div class="bus-axle"></div>';
  tr1.slice(midT).forEach(function(p) { h += mkRuedaVer(p); });
  h += '</div>';

  // Eje central (tipo 2 - doble piso)
  if (tr2.length) {
    var midT2 = Math.ceil(tr2.length / 2);
    h += '<div class="bus-row">';
    tr2.slice(0, midT2).forEach(function(p) { h += mkRuedaVer(p); });
    h += '<div class="bus-axle"></div>';
    tr2.slice(midT2).forEach(function(p) { h += mkRuedaVer(p); });
    h += '</div>';
  }

  // Auxilio
  var auxList = L.aux || ['ra'];
  h += '<div class="aux-row"><span class="aux-label">Aux.</span>' + auxList.map(function(p) { return mkRuedaVer(p); }).join('') + '</div>';

  document.getElementById('diagrama-ver').innerHTML = h;
}

window.addEventListener('DOMContentLoaded', function() {
  renderDiagrama(${tipoUnidad});
});
</script>

<div class="list-head">
  <h2>OT N° ${ot.numero || ot.id}</h2>
  <button class="btn-ghost" onclick="window.print()">Imprimir</button>
</div>

${ot.anulada ? `<div style="margin-bottom:1.25rem; padding:12px 16px; border:1px solid var(--red-bright);
  border-left:4px solid var(--red-bright); border-radius:var(--radius); background:rgba(198,40,40,0.08);">
  <strong style="color:var(--red-bright); font-family:var(--font-display); letter-spacing:0.06em;">OT ANULADA</strong>
  <div style="font-size:12.5px; margin-top:4px; color:var(--text-secondary);">
    Anulada por <strong>${e(ot.anulada_por || '-')}</strong> el ${fmtFechaHora(ot.anulada_en)}${ot.motivo_anulacion ? ' — ' + e(ot.motivo_anulacion) : ''}
  </div>
</div>` : ''}

<div class="ver-wrap">

  <!-- Diagrama -->
  <div class="diagrama-panel">
    <div class="diagrama-title">${esquema ? 'Esquema al cerrar la OT' : 'Esquema de cubiertas'}</div>
    <div id="diagrama-ver"></div>
    <div class="leyenda">
      <div class="leyenda-item"><div class="leyenda-dot ocupada"></div> Con cubierta</div>
      <div class="leyenda-item"><div class="leyenda-dot vacia"></div> Vacía</div>
      ${esquema ? '<div class="leyenda-item"><div class="leyenda-dot cambiada"></div> Cambió en esta OT</div>' : ''}
      ${esquema && !esquema.completo ? '<div class="leyenda-item"><div class="leyenda-dot sin-registro"></div> Sin registro</div>' : ''}
    </div>
    ${esquema && !esquema.completo ? '<p class="diagrama-nota">Esta OT se cerró antes de que el sistema guardara cómo quedaba armada la unidad: se ven solo las posiciones que cambió.</p>' : ''}
  </div>

  <!-- Info -->
  <div class="ver-info">
    <div class="ver-meta">
      <div class="ver-meta-item"><strong>Unidad</strong>${ot.unidad || '-'}</div>
      <div class="ver-meta-item"><strong>Estado</strong>${ot.estado == 0 ? 'Pendiente' : 'Cerrada'}</div>
      <div class="ver-meta-item"><strong>Gomería</strong>${ot.gomeria_nombre || '-'}</div>
      <div class="ver-meta-item"><strong>Fecha de solicitud</strong>${fmtFecha(ot.fecha)}</div>
      <div class="ver-meta-item"><strong>Ingreso</strong>${fmtFechaHora(ot.creado_en)}</div>
      <div class="ver-meta-item"><strong>Salida</strong>${salida}</div>
      ${demora ? '<div class="ver-meta-item"><strong>' + (abierta ? 'Abierta hace' : 'Duración') + '</strong>' + demora + '</div>' : ''}
      <div class="ver-meta-item"><strong>Km de la unidad</strong>${ot.km != null ? Number(ot.km).toLocaleString('es-AR') + ' km' : '-'}</div>
      ${ot.cerrado_por ? '<div class="ver-meta-item"><strong>Cerrada por</strong>' + e(ot.cerrado_por) + '</div>' : ''}
      ${trabajos.length ? '<div class="ver-meta-item" style="grid-column:1/-1"><strong>Trabajos</strong>' + trabajos.join(' · ') + '</div>' : ''}
      ${motivos.length ? '<div class="ver-meta-item" style="grid-column:1/-1"><strong>Motivo</strong><span style="color:var(--red-bright); font-weight:bold;">' + motivos.join(' · ') + '</span></div>' : ''}
      ${ot.observaciones ? '<div class="ver-meta-item" style="grid-column:1/-1"><strong>Observaciones</strong>' + e(ot.observaciones) + '</div>' : ''}
      ${ot.descripcion_cierre ? '<div class="ver-meta-item" style="grid-column:1/-1"><strong>Descripción del cierre</strong>' + e(ot.descripcion_cierre) + '</div>' : ''}
      ${ot.factura ? '<div class="ver-meta-item"><strong>Factura</strong>' + ot.factura + '</div>' : ''}
      ${ot.costo   ? '<div class="ver-meta-item"><strong>Costo</strong>$' + ot.costo + '</div>' : ''}
    </div>

    <div class="ver-section-title">Detalle de cubiertas</div>
    <table>
      <thead>
        <tr>
          <th>Posición</th>
          <th>Fuego</th>
          <th>Modelo</th>
          <th>Medida</th>
          <th>Km</th>
          <th>Sale</th>
        </tr>
      </thead>
      <tbody>
        ${cubiertas.length === 0 && vaciadas.length === 0
          ? '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);font-family:var(--font-mono);font-size:12px;">Sin cubiertas registradas</td></tr>'
          : cubiertas.map((c, i) => `<tr class="${i % 2 === 0 ? 'light' : 'dark'}">
              <td>${c.posicion ? posNombre(c.posicion) : '-'}</td>
              <td style="font-family:var(--font-mono)">${c.fuego || '-'}</td>
              <td>${c.marca || ''} ${c.modelo_nombre || ''}</td>
              <td style="font-family:var(--font-mono)">${c.medida || '-'}</td>
              <td style="font-family:var(--font-mono)">${c.km || 0}</td>
              <td style="font-family:var(--font-mono)">${e(saleDe(c) || '-')}</td>
            </tr>`).join('')
          + vaciadas.map(v => `<tr>
              <td>${posNombre(v.posicion)}</td>
              <td colspan="4" style="color:var(--text-muted)">${v.destino ? 'queda vacía: la cubierta pasó a ' + posNombre(v.destino) : 'queda vacía'}</td>
              <td style="font-family:var(--font-mono)">${e(v.fuego || '-')}</td>
            </tr>`).join('')
        }
      </tbody>
    </table>

    <a href="/OTs/list" class="list-back">&laquo; Volver al listado</a>
  </div>

</div>
`;
%>
<%- include('../layout', { body, user, currentPage }) %>
